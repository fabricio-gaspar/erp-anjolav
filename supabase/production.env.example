# Copie para supabase/.env.production e preencha SOMENTE fora do Git.
# Não acrescente SUPABASE_URL, SUPABASE_ANON_KEY ou SUPABASE_SERVICE_ROLE_KEY:
# a plataforma injeta essas variáveis nas Edge Functions hospedadas.

# Origens exatas do frontend de produção. Sem caminho, barra final ou curingas.
ALLOWED_ORIGINS=https://erp.seudominio.com.br

# Asaas real. Use a chave de produção e dois tokens aleatórios, exclusivos e rotacionáveis.
ASAAS_ENVIRONMENT=production
ASAAS_API_KEY=__SET_ASAAS_PRODUCTION_KEY__
ASAAS_WEBHOOK_TOKEN=__GENERATE_RANDOM_TOKEN_AT_LEAST_32_CHARS__
ASAAS_WEBHOOK_PUBLIC_URL=https://lbrsblimephbjyjlrefv.supabase.co/functions/v1/asaas-webhook

# Evolution API. Informe hosts sem protocolo, porta ou caminho.
EVOLUTION_API_KEY=__SET_EVOLUTION_INSTANCE_KEY__
EVOLUTION_ALLOWED_HOSTS=evolution.seudominio.com.br

# n8n. O endpoint deve validar o header X-AnjoLav-Webhook-Token com este mesmo valor.
N8N_ALLOWED_HOSTS=n8n.seudominio.com.br
N8N_WEBHOOK_TOKEN=__GENERATE_RANDOM_TOKEN_AT_LEAST_32_CHARS__

# Proteção obrigatória para produção.
ENABLE_DESTRUCTIVE_DATA_ADMIN=false
