# Secrets para execução local das Edge Functions. Nunca faça commit dos valores reais.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# Use "sandbox" durante homologação e "production" somente após o go-live aprovado.
ASAAS_ENVIRONMENT=sandbox
ASAAS_API_KEY=substitua_por_um_secret
ASAAS_WEBHOOK_TOKEN=use_um_token_aleatorio_com_32_ou_mais_caracteres
# Opcional para domínio customizado; por padrão usa SUPABASE_URL/functions/v1/asaas-webhook.
ASAAS_WEBHOOK_PUBLIC_URL=https://SEU_PROJECT_REF.supabase.co/functions/v1/asaas-webhook

WA_AKG_API_KEY=substitua_por_chave_criada_na_vps
WA_AKG_ALLOWED_HOSTS=whatsapp.exemplo.com
WA_AKG_WEBHOOK_SECRET=use_um_token_aleatorio_com_32_ou_mais_caracteres
WA_AKG_ENABLED=false
N8N_ALLOWED_HOSTS=n8n.exemplo.com
N8N_WEBHOOK_TOKEN=use_um_token_aleatorio_com_32_ou_mais_caracteres

# Fiscal permanece desativado até existir adaptador específico homologado.
NFSE_ENABLED=false

# Mantenha false em produção. Habilita importação e exclusão pela interface administrativa.
ENABLE_DESTRUCTIVE_DATA_ADMIN=false
