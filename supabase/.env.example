# Integração NFS-e Nacional. Não coloque certificados ou tokens reais neste arquivo.
NFSE_ENABLED=false
NFSE_PRODUCTION_ENABLED=false
NFSE_BRIDGE_BASE_URL=https://fiscal.example.invalid/
NFSE_BRIDGE_ALLOWED_HOSTS=fiscal.example.invalid
NFSE_BRIDGE_TOKEN=substitua_no_cofre_de_segredos

# O certificado de cada CNPJ deve permanecer no bridge fiscal seguro.
# A tabela configuracoes_fiscais guarda apenas credencial_ref, nunca o certificado ou sua senha.
